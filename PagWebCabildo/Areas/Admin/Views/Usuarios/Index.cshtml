@model IReadOnlyList<Administrador>
@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Cuentas de administrador</h1>
    <a asp-action="Crear" class="btn btn-primary">Crear administrador</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No hay cuentas de administrador registradas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Nombre de usuario</th>
                <th scope="col">Rol</th>
                <th scope="col">Estado</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var administrador in Model)
            {
                <tr>
                    <td>@administrador.Nombre</td>
                    <td>@administrador.NombreUsuario</td>
                    <td>@EtiquetaRol(administrador.Rol)</td>
                    <td>
                        @if (administrador.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Editar" asp-route-id="@administrador.Id"
                           class="btn btn-sm btn-outline-primary">Editar</a>

                        @if (administrador.Activo)
                        {
                            <form asp-action="Desactivar" asp-route-id="@administrador.Id"
                                  method="post" class="d-inline"
                                  onsubmit="return confirm('¿Desactivar esta cuenta? No podrá iniciar sesión.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">Desactivar</button>
                            </form>
                        }

                        <form asp-action="Eliminar" asp-route-id="@administrador.Id"
                              method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar esta cuenta de administrador? Esta acción no se puede deshacer.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@functions {
    // Devuelve la etiqueta en español del rol, tomada de la anotación [Display]
    // del enum para mantener la coherencia con los selectores de los formularios.
    private static string EtiquetaRol(Rol rol)
    {
        var miembro = typeof(Rol).GetMember(rol.ToString()).FirstOrDefault();
        var display = miembro?
            .GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
            .Cast<System.ComponentModel.DataAnnotations.DisplayAttribute>()
            .FirstOrDefault();
        return display?.Name ?? rol.ToString();
    }
}
