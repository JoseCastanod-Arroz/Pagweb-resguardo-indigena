@*
    Formulario de creación de un tema de galería con portada opcional (Requisito
    33.1). Usa enctype multipart/form-data para la carga del archivo y token
    antifalsificación; la validación por Data Annotations se refuerza del lado del
    cliente con los scripts de validación.
*@
@model TemaFormViewModel
@{
    ViewData["Title"] = "Nuevo tema";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Nuevo tema</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
</div>

<form asp-action="CrearTema" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control"/>
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Portada" class="form-label"></label>
        <input asp-for="Portada" class="form-control" type="file" accept="image/*"/>
        <span asp-validation-for="Portada" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Crear tema</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
