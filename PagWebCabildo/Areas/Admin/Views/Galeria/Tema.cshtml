@*
    Gestión de los elementos (fotos y videos) de un tema de galería (Requisitos
    35.1, 36.1, 36.2, 36.3). Permite subir elementos, editarlos y eliminarlos. El
    botón de eliminar solo se muestra al Administrador General como cortesía de UI;
    la política "EliminarContenido" lo refuerza del lado del servidor.
*@
@model TemaGaleria
@{
    ViewData["Title"] = $"Tema: {Model.Nombre}";
    var esAdminGeneral = User.IsInRole("AdministradorGeneral");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">@Model.Nombre</h1>
        @if (!string.IsNullOrEmpty(Model.Descripcion))
        {
            <p class="text-muted mb-0">@Model.Descripcion</p>
        }
    </div>
    <div>
        <a class="btn btn-primary" asp-action="SubirElemento" asp-route-temaId="@Model.Id">Subir elemento</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
    </div>
</div>

@if (!Model.Elementos.Any())
{
    <p class="text-muted">Este tema no tiene elementos aún.</p>
}
else
{
    <div class="row g-3">
        @foreach (var elemento in Model.Elementos)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card h-100">
                    @if (elemento.Tipo == TipoElemento.Foto)
                    {
                        <img src="~/@elemento.ArchivoRuta" alt="@elemento.Descripcion" class="card-img-top" style="max-height: 180px; object-fit: cover;"/>
                    }
                    else
                    {
                        <video class="card-img-top" style="max-height: 180px;" controls>
                            <source src="~/@elemento.ArchivoRuta"/>
                        </video>
                    }
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">@elemento.Tipo</span>
                        <p class="card-text small">@elemento.Descripcion</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditarElemento" asp-route-id="@elemento.Id">Editar</a>
                        @if (esAdminGeneral)
                        {
                            <form asp-action="EliminarElemento" asp-route-id="@elemento.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar este elemento? Esta acción no se puede deshacer.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
