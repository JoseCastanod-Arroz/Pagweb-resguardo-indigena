@*
    Formulario de edición de un elemento de galería (Requisitos 36.1, 36.2). Permite
    cambiar el tipo y la descripción, y reemplazar el archivo; si no se sube uno
    nuevo, se conserva el existente. Muestra el archivo actual cuando lo hay. Usa
    enctype multipart/form-data y token antifalsificación.
*@
@model ElementoFormViewModel
@{
    ViewData["Title"] = "Editar elemento";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Editar elemento</h1>
    <a class="btn btn-outline-secondary" asp-action="Tema" asp-route-id="@Model.TemaGaleriaId">Volver</a>
</div>

<form asp-action="EditarElemento" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id"/>
    <input type="hidden" asp-for="TemaGaleriaId"/>
    <input type="hidden" asp-for="ArchivoRutaActual"/>

    <div class="mb-3">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoElemento>()" class="form-select"></select>
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.ArchivoRutaActual))
    {
        <div class="mb-3">
            <label class="form-label">Archivo actual</label>
            <div>
                @if (Model.Tipo == TipoElemento.Foto)
                {
                    <img src="~/@Model.ArchivoRutaActual" alt="Elemento de galería" class="img-thumbnail" style="max-height: 200px;"/>
                }
                else
                {
                    <video style="max-height: 200px;" controls>
                        <source src="~/@Model.ArchivoRutaActual"/>
                    </video>
                }
            </div>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Archivo" class="form-label"></label>
        <input asp-for="Archivo" class="form-control" type="file" accept="image/*,video/*"/>
        <span asp-validation-for="Archivo" class="text-danger"></span>
        <div class="form-text">Si no selecciona un archivo, se conserva el archivo actual.</div>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-outline-secondary" asp-action="Tema" asp-route-id="@Model.TemaGaleriaId">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
