@*
    Listado de gestión de temas de la galería del Panel de Administración
    (Requisitos 33.1, 34.1, 34.2, 34.3). Ofrece crear, editar, gestionar elementos y
    eliminar. El botón de eliminar solo se muestra al Administrador General como
    cortesía de UI; la política "EliminarContenido" lo refuerza del lado del servidor.
*@
@model IReadOnlyList<TemaGaleria>
@{
    ViewData["Title"] = "Galería";
    var esAdminGeneral = User.IsInRole("AdministradorGeneral");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Galería</h1>
    <a class="btn btn-primary" asp-action="CrearTema">Nuevo tema</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No hay temas de galería registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th scope="col">Portada</th>
                <th scope="col">Nombre</th>
                <th scope="col">Descripción</th>
                <th scope="col">Elementos</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var tema in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrEmpty(tema.PortadaRuta))
                        {
                            <img src="~/@tema.PortadaRuta" alt="Portada de @tema.Nombre" class="img-thumbnail" style="max-height: 60px;"/>
                        }
                        else
                        {
                            <span class="text-muted">Sin portada</span>
                        }
                    </td>
                    <td>@tema.Nombre</td>
                    <td>@tema.Descripcion</td>
                    <td>@tema.Elementos.Count</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Tema" asp-route-id="@tema.Id">Elementos</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditarTema" asp-route-id="@tema.Id">Editar</a>
                        @if (esAdminGeneral)
                        {
                            <form asp-action="EliminarTema" asp-route-id="@tema.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar este tema y todos sus elementos? Esta acción no se puede deshacer.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
