@*
    Formulario para subir una foto o un video a un tema de galería (Requisito 35.1).
    Usa enctype multipart/form-data para la carga del archivo y token
    antifalsificación; la validación por Data Annotations se refuerza del lado del
    cliente con los scripts de validación.
*@
@model ElementoFormViewModel
@{
    ViewData["Title"] = "Subir elemento";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Subir elemento@(string.IsNullOrEmpty(Model.TemaNombre) ? "" : $" a «{Model.TemaNombre}»")</h1>
    <a class="btn btn-outline-secondary" asp-action="Tema" asp-route-id="@Model.TemaGaleriaId">Volver</a>
</div>

<form asp-action="SubirElemento" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="TemaGaleriaId"/>
    <input type="hidden" asp-for="TemaNombre"/>

    <div class="mb-3">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoElemento>()" class="form-select"></select>
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Archivo" class="form-label"></label>
        <input asp-for="Archivo" class="form-control" type="file" accept="image/*,video/*"/>
        <span asp-validation-for="Archivo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Subir elemento</button>
    <a class="btn btn-outline-secondary" asp-action="Tema" asp-route-id="@Model.TemaGaleriaId">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
