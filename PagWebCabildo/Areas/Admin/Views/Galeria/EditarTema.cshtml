@*
    Formulario de edición de un tema de galería (Requisitos 34.1, 34.2). Permite
    reemplazar la portada; si no se sube una nueva, se conserva la existente. Muestra
    la portada actual cuando la hay. Usa enctype multipart/form-data y token
    antifalsificación.
*@
@model TemaFormViewModel
@{
    ViewData["Title"] = "Editar tema";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Editar tema</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
</div>

<form asp-action="EditarTema" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id"/>
    <input type="hidden" asp-for="PortadaRutaActual"/>

    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control"/>
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.PortadaRutaActual))
    {
        <div class="mb-3">
            <label class="form-label">Portada actual</label>
            <div>
                <img src="~/@Model.PortadaRutaActual" alt="Portada del tema" class="img-thumbnail" style="max-height: 200px;"/>
            </div>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Portada" class="form-label"></label>
        <input asp-for="Portada" class="form-control" type="file" accept="image/*"/>
        <span asp-validation-for="Portada" class="text-danger"></span>
        <div class="form-text">Si no selecciona un archivo, se conserva la portada actual.</div>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
