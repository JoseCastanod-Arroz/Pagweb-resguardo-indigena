@model PagWebCabildo.Areas.Admin.Models.HistoriaViewModel
@*
    Formulario de edición del texto de historia y presentación del resguardo
    (Requisito 24.1). Muestra el contenido actual en un textarea y lo persiste
    mediante POST con token antifalsificación. Tras guardar, muestra un mensaje de
    éxito a partir de TempData. Usa el layout _AdminLayout definido por el
    _ViewStart del área.
*@
@{
    ViewData["Title"] = "Historia y presentación";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Historia y presentación</h1>
    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Volver al panel</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}

<p class="text-muted">Edite el texto que se muestra en la sección de Historia del sitio público.</p>

<form asp-area="Admin" asp-controller="Paginas" asp-action="Historia" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Texto" class="form-label"></label>
        <textarea asp-for="Texto" class="form-control" rows="12"></textarea>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
</form>
