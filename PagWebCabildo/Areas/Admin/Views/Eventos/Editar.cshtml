@*
    Formulario de edición de un evento (Requisitos 28.1, 28.2). Permite reemplazar
    la imagen; si no se sube una nueva, se conserva la existente. Muestra la imagen
    actual cuando la hay. Usa enctype multipart/form-data y token antifalsificación.
*@
@model EventoFormViewModel
@{
    ViewData["Title"] = "Editar evento";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Editar evento</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
</div>

<form asp-action="Editar" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id"/>
    <input type="hidden" asp-for="ImagenRutaActual"/>

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control"/>
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Fecha" class="form-label"></label>
            <input asp-for="Fecha" class="form-control" type="date"/>
            <span asp-validation-for="Fecha" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Hora" class="form-label"></label>
            <input asp-for="Hora" class="form-control" type="time"/>
            <span asp-validation-for="Hora" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Lugar" class="form-label"></label>
        <input asp-for="Lugar" class="form-control"/>
        <span asp-validation-for="Lugar" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.ImagenRutaActual))
    {
        <div class="mb-3">
            <label class="form-label">Imagen actual</label>
            <div>
                <img src="~/@Model.ImagenRutaActual" alt="Imagen del evento" class="img-thumbnail" style="max-height: 200px;"/>
            </div>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Imagen" class="form-label"></label>
        <input asp-for="Imagen" class="form-control" type="file" accept="image/*"/>
        <span asp-validation-for="Imagen" class="text-danger"></span>
        <div class="form-text">Si no selecciona un archivo, se conserva la imagen actual.</div>
    </div>

    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
