@*
    Documentos financieros del Panel de Administración (Requisitos 6.1, 6.2, 6.3).
    Lista los documentos cuya categoría está marcada como financiera. Es la ruta
    autorizada del rol Tesorero (política "GestionFinanciera"); el Administrador
    General también accede. El botón de eliminar se muestra únicamente al
    Administrador General, y la política "EliminarContenido" lo refuerza del lado
    del servidor.
*@
@model IReadOnlyList<Documento>
@{
    ViewData["Title"] = "Documentos financieros";
    var esAdminGeneral = User.IsInRole("AdministradorGeneral");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Documentos financieros</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Categorias">Gestionar categorías</a>
        <a class="btn btn-primary" asp-action="Subir">Subir documento</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">No hay documentos financieros. Marque una categoría como financiera y suba documentos en ella.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th scope="col">Título</th>
                <th scope="col">Descripción</th>
                <th scope="col">Categoría</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var documento in Model)
            {
                <tr>
                    <td>@documento.Titulo</td>
                    <td>@documento.Descripcion</td>
                    <td>@documento.CategoriaDocumento?.Nombre</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@documento.Id">Editar</a>
                        @if (esAdminGeneral)
                        {
                            <form asp-action="Eliminar" asp-route-id="@documento.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar este documento? Esta acción no se puede deshacer.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
