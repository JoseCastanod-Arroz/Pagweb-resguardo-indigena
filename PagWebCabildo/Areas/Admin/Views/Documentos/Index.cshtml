@*
    Landing de gestión de documentos del Panel de Administración (Requisito 37.1).
    Lista los documentos agrupados por categoría, con accesos a la gestión de
    categorías y a la carga de documentos. El botón de eliminar documento se
    muestra únicamente al Administrador General; la política "EliminarContenido"
    lo refuerza del lado del servidor (Requisito 39.3).
*@
@model IReadOnlyList<CategoriaDocumento>
@{
    ViewData["Title"] = "Documentos";
    var esAdminGeneral = User.IsInRole("AdministradorGeneral");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Documentos</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Categorias">Gestionar categorías</a>
        <a class="btn btn-primary" asp-action="Subir">Subir documento</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">No hay categorías registradas. Cree una categoría para poder subir documentos.</p>
}
else
{
    @foreach (var categoria in Model)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0">
                    @categoria.Nombre
                    @if (categoria.EsPublica)
                    {
                        <span class="badge bg-success ms-2">Pública</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">Privada</span>
                    }
                </h2>
                @* Eliminar categoría: solo Administrador General (política EliminarContenido). *@
                @if (esAdminGeneral)
                {
                    <form asp-action="EliminarCategoria" asp-route-id="@categoria.Id" method="post" class="d-inline"
                          onsubmit="return confirm('¿Eliminar esta categoría? Se eliminarán también sus documentos. Esta acción no se puede deshacer.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar categoría</button>
                    </form>
                }
            </div>
            <div class="card-body">
                @if (!categoria.Documentos.Any())
                {
                    <p class="text-muted mb-0">No hay documentos en esta categoría.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                            <tr>
                                <th scope="col">Título</th>
                                <th scope="col">Descripción</th>
                                <th scope="col" class="text-end">Acciones</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var documento in categoria.Documentos)
                            {
                                <tr>
                                    <td>@documento.Titulo</td>
                                    <td>@documento.Descripcion</td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="DescargarPrivado" asp-route-id="@documento.Id">Descargar</a>
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@documento.Id">Editar</a>
                                        @if (esAdminGeneral)
                                        {
                                            <form asp-action="Eliminar" asp-route-id="@documento.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Eliminar este documento? Esta acción no se puede deshacer.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
}
