@*
    Gestión de categorías de documentos (Requisitos 37.1, 37.2, 37.3, 37.4).
    Permite crear, editar y eliminar categorías. El botón de eliminar se muestra
    únicamente al Administrador General; la política "EliminarContenido" lo hace
    cumplir en el servidor en cualquier caso.
*@
@model IReadOnlyList<CategoriaDocumento>
@{
    ViewData["Title"] = "Categorías de documentos";
    var esAdminGeneral = User.IsInRole("AdministradorGeneral");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Categorías de documentos</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Index">Volver a documentos</a>
        <a class="btn btn-primary" asp-action="CrearCategoria">Crear categoría</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">No hay categorías registradas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Visibilidad</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var categoria in Model)
            {
                <tr>
                    <td>@categoria.Nombre</td>
                    <td>
                        @if (categoria.EsPublica)
                        {
                            <span class="badge bg-success">Pública</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Privada</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="EditarCategoria" asp-route-id="@categoria.Id">Editar</a>
                        @if (esAdminGeneral)
                        {
                            <form asp-action="EliminarCategoria" asp-route-id="@categoria.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar esta categoría? Se eliminarán también sus documentos. Esta acción no se puede deshacer.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
