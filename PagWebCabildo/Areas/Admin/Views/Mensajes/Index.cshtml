@*
    Listado de gestión de mensajes del Panel de Administración ordenado del más
    reciente al más antiguo (Requisitos 41.1, 41.2). Cada fila muestra el nombre,
    asunto, fecha de recepción y estado de atención, con enlace al detalle.
*@
@model IReadOnlyList<Mensaje>
@{
    ViewData["Title"] = "Mensajes";
}

<h1 class="h3 mb-4">Mensajes de contacto</h1>

@if (!Model.Any())
{
    <p class="text-muted">No hay mensajes registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th scope="col">Nombre</th>
                <th scope="col">Asunto</th>
                <th scope="col">Fecha de recepción</th>
                <th scope="col">Estado</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var mensaje in Model)
            {
                <tr>
                    <td>@mensaje.Nombre</td>
                    <td>@mensaje.Asunto</td>
                    <td>@mensaje.FechaRecepcion.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (mensaje.Atendido)
                        {
                            <span class="badge bg-success">Atendido</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Sin atender</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Ver" asp-route-id="@mensaje.Id">Ver</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
