@*
    Formulario de creación de un acta de asamblea con consecutivo, fecha, tipo,
    título, descripción y archivo adjunto (Requisitos 3.1, 4.1). El archivo es
    obligatorio al crear. Usa enctype multipart/form-data para la carga del archivo
    y token antifalsificación; el tipo de asamblea se elige de un desplegable del
    enum TipoAsamblea.
*@
@model ActaFormViewModel
@{
    ViewData["Title"] = "Nueva acta";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Nueva acta</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
</div>

<form asp-action="Crear" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Consecutivo" class="form-label"></label>
        <input asp-for="Consecutivo" class="form-control"/>
        <span asp-validation-for="Consecutivo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FechaAsamblea" class="form-label"></label>
        <input asp-for="FechaAsamblea" class="form-control" type="date"/>
        <span asp-validation-for="FechaAsamblea" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tipo" class="form-label"></label>
        <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoAsamblea>()" class="form-select"></select>
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control"/>
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Archivo" class="form-label"></label>
        <input asp-for="Archivo" class="form-control" type="file"/>
        <span asp-validation-for="Archivo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrar acta</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
