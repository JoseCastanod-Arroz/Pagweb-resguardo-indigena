@*
    Layout del Panel de Administración (Area Admin). Presenta el menú de acceso a
    cada módulo de gestión (Requisito 20.1) y un indicador del usuario con sesión
    iniciada, además del enlace para cerrar sesión (Requisito 19.1).
    Reutiliza los mismos activos (Bootstrap, jQuery y site.css) que el layout público.
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Panel de Administración</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/PagWebCabildo.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Panel de Administración</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarAdmin" aria-expanded="false" aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                @*
                    Cada opción del menú se muestra solo a los roles autorizados para el
                    módulo destino, replicando las políticas definidas en Program.cs. Así,
                    por ejemplo, el Secretario ve únicamente las secciones que puede usar
                    (no "Usuarios" ni "Mensajes"). Los módulos con [Authorize] abierto
                    (Panel, Historia, Autoridades, Galería, Documentos, Contacto) siguen
                    visibles para cualquier usuario autenticado.
                *@
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-light" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Panel</a>
                    </li>
                    @* Usuarios: política GestionCuentas → solo AdministradorGeneral *@
                    @if (User.IsInRole("AdministradorGeneral"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                        </li>
                    }
                    @* Historia: política GestionHistoria → AdministradorGeneral, Secretario *@
                    @if (User.IsInRole("AdministradorGeneral") || User.IsInRole("Secretario"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Paginas" asp-action="Historia">Historia</a>
                        </li>
                    }
                    @* Autoridades: política GestionContenidoEditorial → AdministradorGeneral, Secretario, Fiscal *@
                    @if (User.IsInRole("AdministradorGeneral") || User.IsInRole("Secretario") || User.IsInRole("Fiscal"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Autoridades" asp-action="Index">Autoridades</a>
                        </li>
                    }
                    @* Eventos y Comunicados: política GestionComunicadosEventos → AdministradorGeneral, Secretario, Comisario *@
                    @if (User.IsInRole("AdministradorGeneral") || User.IsInRole("Secretario") || User.IsInRole("Comisario"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Eventos" asp-action="Index">Eventos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Comunicados" asp-action="Index">Comunicados</a>
                        </li>
                    }
                    @* Galería: política GestionContenidoEditorial → AdministradorGeneral, Secretario, Fiscal *@
                    @if (User.IsInRole("AdministradorGeneral") || User.IsInRole("Secretario") || User.IsInRole("Fiscal"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Galeria" asp-action="Index">Galería</a>
                        </li>
                    }
                    @* Documentos: política GestionDocumentos → todos menos Comisario *@
                    @if (!User.IsInRole("Comisario"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Documentos" asp-action="Index">Documentos</a>
                        </li>
                    }
                    @* Actas: política ConsultaActas → AdministradorGeneral, Secretario, Fiscal *@
                    @if (User.IsInRole("AdministradorGeneral") || User.IsInRole("Secretario") || User.IsInRole("Fiscal"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Actas" asp-action="Index">Actas</a>
                        </li>
                    }
                    @* Veeduría (registro de actividad): política Veeduria → AdministradorGeneral, Fiscal *@
                    @if (User.IsInRole("AdministradorGeneral") || User.IsInRole("Fiscal"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="RegistroActividad" asp-action="Index">Veeduría</a>
                        </li>
                    }
                    @* Contacto: contenido editorial (política GestionContenidoGeneral) → todos menos Tesorero *@
                    @if (!User.IsInRole("Tesorero"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Contacto" asp-action="Editar">Contacto</a>
                        </li>
                    }
                    @* Mensajes: política GestionMensajes → AdministradorGeneral, Comisario *@
                    @if (User.IsInRole("AdministradorGeneral") || User.IsInRole("Comisario"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Mensajes" asp-action="Index">Mensajes</a>
                        </li>
                    }
                    @* Foro: política ModerarForo → AdministradorGeneral, Comisario *@
                    @if (User.IsInRole("AdministradorGeneral") || User.IsInRole("Comisario"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="Admin" asp-controller="Foro" asp-action="Index">Foro</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="navbar-text text-light me-3">
                                Sesión: <strong>@User.Identity?.Name</strong>
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - Resguardo Indígena Rincón Bodega - Panel de Administración
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
