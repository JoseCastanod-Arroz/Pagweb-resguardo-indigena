@*
    Formulario de edición de una autoridad existente (Requisito 25.2). El Id viaja
    en un campo oculto para que el controlador valide la coincidencia con la ruta.
*@
@model Autoridad
@{
    ViewData["Title"] = "Editar autoridad";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Editar autoridad</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
</div>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id"/>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control"/>
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cargo" class="form-label"></label>
                <input asp-for="Cargo" class="form-control"/>
                <span asp-validation-for="Cargo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TipoAutoridad" class="form-label">Tipo</label>
                <select asp-for="TipoAutoridad" class="form-select">
                    <option value="">Seleccione…</option>
                    <option value="autoridad">Autoridad</option>
                    <option value="cargo">Cargo</option>
                    <option value="comité">Comité</option>
                </select>
                <span asp-validation-for="TipoAutoridad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Funcion" class="form-label"></label>
                <textarea asp-for="Funcion" class="form-control" rows="5"
                          placeholder="Describe las funciones del cargo (según el Reglamento Interno)."></textarea>
                <span asp-validation-for="Funcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Orden" class="form-label"></label>
                <input asp-for="Orden" class="form-control" type="number"/>
                <span asp-validation-for="Orden" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
