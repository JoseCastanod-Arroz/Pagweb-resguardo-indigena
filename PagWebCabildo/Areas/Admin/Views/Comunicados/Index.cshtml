@*
    Listado de gestión de comunicados del Panel de Administración (Requisitos 30.1,
    31.3, 32.4). Muestra título, fecha y estado (Borrador/Publicado) y ofrece crear,
    editar, publicar (solo tiene sentido desde borrador) y eliminar. El botón de
    eliminar solo se muestra al Administrador General como cortesía de UI; la política
    "EliminarContenido" lo refuerza del lado del servidor. Los avisos TempData
    informan del resultado de publicar/guardar/eliminar.
*@
@model IReadOnlyList<Comunicado>
@{
    ViewData["Title"] = "Comunicados";
    var esAdminGeneral = User.IsInRole("AdministradorGeneral");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Comunicados</h1>
    <a class="btn btn-primary" asp-action="Crear">Nuevo comunicado</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (!Model.Any())
{
    <p class="text-muted">No hay comunicados registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th scope="col">Título</th>
                <th scope="col">Fecha</th>
                <th scope="col">Estado</th>
                <th scope="col" class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var comunicado in Model)
            {
                <tr>
                    <td>@comunicado.Titulo</td>
                    <td>@comunicado.Fecha.ToString("yyyy-MM-dd")</td>
                    <td>
                        @if (comunicado.Estado == EstadoComunicado.Publicado)
                        {
                            <span class="badge bg-success">Publicado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Borrador</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@comunicado.Id">Editar</a>
                        @if (comunicado.Estado == EstadoComunicado.Borrador)
                        {
                            <form asp-action="Publicar" asp-route-id="@comunicado.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">Publicar</button>
                            </form>
                        }
                        @if (esAdminGeneral)
                        {
                            <form asp-action="Eliminar" asp-route-id="@comunicado.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar este comunicado? Esta acción no se puede deshacer.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
