@model PagWebCabildo.Models.Entidades.Comunicado
@{
    ViewData["Title"] = Model.Titulo;
}

<article>
    <h1>@Model.Titulo</h1>
    <p class="text-muted">@Model.Fecha.ToString("dd/MM/yyyy")</p>
    <div>
        @foreach (var parrafo in Model.Contenido.Split('\n', StringSplitOptions.RemoveEmptyEntries))
        {
            <p>@parrafo</p>
        }
    </div>
</article>

<p>
    <a asp-controller="Comunicados" asp-action="Index">Volver a comunicados</a>
</p>
